// Personal signing settings. Copy to Local.xcconfig (git-ignored) and fill in.
// DEVELOPMENT_TEAM: the "OU" of your Apple Development certificate, e.g. from
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
DEVELOPMENT_TEAM =
// Reverse-DNS prefix you own; the app id becomes <prefix>.artemis-watch.
BUNDLE_ID_PREFIX = dev.example
